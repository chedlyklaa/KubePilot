# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See src/config/index.js for the validated subset of these (required vs optional, defaults).

# ─── Core services ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/k8s_agent
API_PORT=3001
DASHBOARD_URL=http://localhost:5173

# ─── LLM (required) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
LLM_TIMEOUT_MS=30000

# Guardian is a second, optionally-separate model/key used for policy review.
# Falls back to OPENAI_* if unset.
GUARDIAN_API_KEY=
GUARDIAN_MODEL=
GUARDIAN_BASE_URL=

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Required. Encrypts stored notification-channel secrets (AES-256-GCM).
# Generate with: openssl rand -hex 32
NOTIFICATION_SECRET=

# ─── Orchestrator / cluster cycle tuning ─────────────────────────────────────
CYCLE_INTERVAL_MS=30000
CLUSTER_CONCURRENCY=3
ISSUE_CONCURRENCY=3

# ─── Analyzer thresholds ─────────────────────────────────────────────────────
NODE_CPU_SAT_THRESHOLD=0.90
NODE_MEM_SAT_THRESHOLD=0.90
NODE_FLAP_TRANSITIONS=2
NODE_FLAP_WINDOW_MS=600000
MASS_FAILURE_THRESHOLD=5
EVENT_MAX_AGE_MS=1800000
EVENT_MIN_COUNT=3
EVENT_RECENT_WINDOW_MS=120000
NODE_CORR_THRESHOLD=
NS_CORR_THRESHOLD=
KUBECTL_WAIT_TIMEOUT=

# ─── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_NAMESPACE=monitoring
GRAFANA_URL=http://localhost:3000

# ─── Feature flags ────────────────────────────────────────────────────────────
CAPACITY_FORECAST_ENABLED=false
CHANGE_CORRELATION_ENABLED=false
FALLBACK_ENABLED=true
POLICY_DRY_RUN=false

# ─── Capacity forecast engine tuning (only used when CAPACITY_FORECAST_ENABLED=true) ─
FORECAST_INTERVAL_CYCLES=
FORECAST_LOOKBACK_HOURS=
FORECAST_MIN_DATAPOINTS=
FORECAST_ALERT_COOLDOWN_MS=

# ─── Vector memory (optional — episodic memory / learned rules disabled if unset) ────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=

# ─── Email notifications (optional) ──────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ─── Teams notifications (optional) ──────────────────────────────────────────
TEAMS_WEBHOOK_URL=
TEAMS_ADMIN_WEBHOOK_URL=
