# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See src/config/index.js for the validated subset of these (required vs optional, defaults).

# ─── Core services ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/k8s_agent
API_PORT=3001
DASHBOARD_URL=http://localhost:5173

# ─── LLM (required) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
LLM_TIMEOUT_MS=30000

# Guardian is a second, optionally-separate model/key used for policy review.
# Falls back to OPENAI_* if unset.
GUARDIAN_API_KEY=
GUARDIAN_MODEL=
GUARDIAN_BASE_URL=

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Required. Encrypts stored notification-channel secrets (AES-256-GCM).
# Generate with: openssl rand -hex 32
NOTIFICATION_SECRET=

# ─── Orchestrator / cluster cycle tuning ─────────────────────────────────────
CYCLE_INTERVAL_MS=30000
CLUSTER_CONCURRENCY=3
ISSUE_CONCURRENCY=3

# ─── Analyzer thresholds ─────────────────────────────────────────────────────
NODE_CPU_SAT_THRESHOLD=0.90
NODE_MEM_SAT_THRESHOLD=0.90
NODE_FLAP_TRANSITIONS=2
NODE_FLAP_WINDOW_MS=600000
MASS_FAILURE_THRESHOLD=5
EVENT_MAX_AGE_MS=1800000
EVENT_MIN_COUNT=3
EVENT_RECENT_WINDOW_MS=120000
NODE_CORR_THRESHOLD=
NS_CORR_THRESHOLD=
KUBECTL_WAIT_TIMEOUT=

# ─── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_NAMESPACE=monitoring
GRAFANA_URL=http://localhost:3000

# ─── Feature flags ────────────────────────────────────────────────────────────
# ORCHESTRATOR_V5_ENABLED is no longer env-driven — the v5 pipeline always runs.
# PolicyEngine.dryRunMode defaults to true (simulate) and is not meant to be
# generically toggled. Leave ALLOW_LIVE_KUBECTL_EXECUTION unset/false in every
# normal deployment — only set it to "true" when intentionally booting a server
# for a real-cluster benchmark run (see src/policy/policyEngine.js).
ALLOW_LIVE_KUBECTL_EXECUTION=false
CAPACITY_FORECAST_ENABLED=false
CHANGE_CORRELATION_ENABLED=false
FALLBACK_ENABLED=true

# ─── Capacity forecast engine tuning (only used when CAPACITY_FORECAST_ENABLED=true) ─
FORECAST_INTERVAL_CYCLES=
FORECAST_LOOKBACK_HOURS=
FORECAST_MIN_DATAPOINTS=
FORECAST_ALERT_COOLDOWN_MS=

# ─── Short-term memory (dedup / namespace grouping / dispatch queue / locks) ─────────
# Defaults to redis://localhost:6379 if unset — dedup/queue/locks disabled without it.
REDIS_URL=redis://localhost:6379

# ─── Vector memory (optional — episodic memory / learned rules disabled if unset) ────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_VECTOR_SIZE=

# ─── Email notifications (optional) ──────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# ─── Teams notifications (optional) ──────────────────────────────────────────
TEAMS_WEBHOOK_URL=
TEAMS_ADMIN_WEBHOOK_URL=

# ─── LangSmith tracing / LangGraph Studio (optional) ─────────────────────────
# Set LANGCHAIN_TRACING_V2=true + LANGCHAIN_API_KEY to enable per-node tracing
# on the LangGraph StateGraph (src/orchestrator/graph.js) and to use
# `npx @langchain/langgraph-cli dev` for LangGraph Studio.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kubepilot

# ─── Developer-only per-pod decision tracer (src/monitoring/incidentTracer.js) ───
# Dev/CLI observability only — never exposed via any API route or the dashboard.
# TRACE_ENABLED=false disables both stdout and ./logs/<workflowId>.jsonl writes.
# TRACE_STDOUT=false keeps writing the log files but stops printing JSON lines to
# stdout. See scripts/trace-cli.js for `trace pod`/`trace incident` usage.
TRACE_ENABLED=true
TRACE_STDOUT=true

# Resume in-flight workflows after an orchestrator restart (LangGraph checkpoints in MongoDB)
WORKFLOW_RESUME_ENABLED=true

# Kubernetes identity for gateways/detection: bootstrap (shared credential) or serviceaccount
# (kubepilot-reader / kubepilot-executor tokens; apply deploy/k8s/target-cluster-rbac.yaml first)
CLUSTER_IDENTITY_MODE=bootstrap
# CLUSTER_IDENTITY_NAMESPACE=kubepilot-system

# ── Agent Mesh (src/mesh/) ────────────────────────────────────────────────────
# Each v5 agent runs in-process ("local", default) or as its own service ("remote",
# started with npm run agent:<name>, or all together via npm run mesh:up).
# MESH_REDIS_URL=redis://localhost:6379     # defaults to REDIS_URL
# MESH_LEASE_MS=30000                       # crashed-worker reclaim after ~2x this
AGENT_FASTPATH_MODE=local
AGENT_INVESTIGATOR_MODE=local
AGENT_PLANNER_MODE=local
AGENT_GUARDIAN_MODE=local
AGENT_REFLECTION_MODE=local
AGENT_K8S_READ_MODE=local
AGENT_K8S_WRITE_MODE=local
# Required when AGENT_K8S_WRITE_MODE=remote: the orchestrator signs every approved plan step
# with it and the k8s-write gateway refuses anything unsigned (src/mesh/writeAuth.js).
# Generate with `openssl rand -hex 32`. NOTE: services started from this shared .env (mesh:up)
# all see it, so this only isolates agents in a real deployment — see deploy/k8s/10-config.yaml.
# MESH_WRITE_SIGNING_KEY=
# MCP_AUTH_TOKEN=                         # enables POST /mcp on k8s-read (read-only MCP tools, bearer auth)
# AGENT_PORT=0                              # agent service HTTP port (card + /healthz); 0 = random
